      "docs/architecture/03-improvement-roadmap.md": "examples/mode-2-audit-monorepo/03-improvement-roadmap.md"
    },
    "line_replace": {
      "services/catalog/app.py": {
        "line": 21,
        "text": "    cursor.execute(\"SELECT * FROM items WHERE name = %s\", (name,))"
      }
    }
  },
  "must_exist": [
